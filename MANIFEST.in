include .dockerignore
include .gitignore
include CONTAINER.md
include Dockerfile
include EXAMPLES.md
include LICENSE
include NOTICE
include README.md
include THIRD_PARTY.md
include build.sh
include environment.yml
include pyproject.toml
include setup.sh

include LICENSES/CC-BY-4.0.txt
include LICENSES/OpenROAD-BSD-3-Clause.txt

include .github/scripts/check_release_artifacts.py
include .github/scripts/check_runtime_core.py
include .github/scripts/record_release_evidence.py
include .github/scripts/smoke_wheel.py
include .github/workflows/coupfe-workbench-pages.yml
include .github/workflows/fast-ci.yml
include .github/workflows/web-ci.yml

recursive-include benchmarks *.json *.md *.py *.txt

include docs/COMPONENTS.md
include docs/API_MIGRATIONS.md
include docs/GEOMETRY.md
include docs/LICENSE.md
include docs/PERIODIC_MPC_STATUS.md
include docs/README.md
include docs/RELEASE_EVIDENCE.md
include docs/TET_FEASIBILITY.md
include docs/VALIDATION_GUIDE.md
include docs/api.md
include docs/capabilities.md
include docs/lessons_learned.md
include docs/roadmap.md
include docs/theory.md
recursive-include docs/history *.md
include docs/validation_guide/generate_figures.py
include docs/validation_guide/README.md
recursive-include docs/validation_guide/figures *.png

recursive-include eda_multiphysics *.py *.md *.csv *.json *.sp *.tcl
prune eda_multiphysics/_tm_*

recursive-include examples *.py *.md *.csv *.json
include examples/tsv_axisymmetric_field/retained/field.json
include examples/tsv_axisymmetric_field/retained/summary.json
include examples/tsv_axisymmetric_field/retained/contour.svg
include examples/tsv_axisymmetric_field/retained/load-sweep.webm
include examples/tsv_axisymmetric_field/retained/visual-evidence.json
include examples/stacked_memory_package/figures/metrics.png
include examples/stacked_memory_package/figures/package_exploded.png
include examples/stacked_memory_package/figures/thermal_comparison.png
include examples/stacked_memory_package/figures/warpage_comparison.png
include examples/stacked_memory_package/fenicsx_verification/comparison.png
include examples/stacked_memory_package/fenicsx_verification/reference_run.txt
recursive-include skills *.md *.yaml

# Retain the reviewed frontend source in the source distribution. The wheel
# ships the optional API adapter, but not the frontend or node_modules; the
# local GUI therefore remains a source-checkout workflow.
graft web
prune web/node_modules
prune web/dist
prune web/coverage
prune web/.vite
prune web/public/repository-assets
prune web/public/legal

include tests/conftest.py
include tests/test_integration_regressions.py
include tests/test_native_element_evaluation.py
include tests/test_periodic_adapter.py
include tests/test_stacked_memory_package.py
include tests/test_toolchain.py
include tests/test_tsv_axisymmetric_field.py
include tests/test_tsv_axisymmetric_visual_media.py
include tests/test_tsv_device.py
include tests/test_tsv_local_3d.py
include tests/test_visual_evidence.py
include tests/test_workbench.py
include tests/test_workbench_api.py

global-exclude __pycache__ *.py[cod] *.f90 *.so *.o *.mod *.a *.lib *.dll *.dylib *.tsbuildinfo
global-exclude *.pdf *.tex *.whl *.zip *.tar *.tgz *.gz *.bz2 *.xz *.7z *.rar
global-exclude .DS_Store
