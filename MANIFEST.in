include README.md
include CONTAINER.md
include EXAMPLES.md
include CoupFE_EDA_TSV_Device_Validation_Release_Plan.md
include Dockerfile
include build.sh
include environment.yml
include setup.sh
recursive-include LICENSES *.txt
recursive-include .github *.yml *.py
recursive-include benchmarks *.json
recursive-include docs *.md *.py *.png
recursive-include eda_multiphysics *.py *.md *.csv *.json *.sp *.tcl *.f90
recursive-include examples *.py *.md *.csv *.json
recursive-include skills *.md *.yaml
prune tests
include tests/conftest.py
include tests/test_integration_regressions.py
include tests/test_periodic_adapter.py
include tests/test_toolchain.py
include tests/test_tsv_device.py
include tests/test_tsv_local_3d.py
exclude docs/RELEASE_READINESS.md
exclude tests/TRUST_NET_FINDINGS.md
prune docs/presentation
prune notes
global-exclude __pycache__ *.py[cod] *.so *.o *.mod *.a *.lib *.dll *.dylib
global-exclude *.pdf *.tex *.whl *.zip *.tar *.tgz *.gz *.bz2 *.xz *.7z *.rar
global-exclude .DS_Store
