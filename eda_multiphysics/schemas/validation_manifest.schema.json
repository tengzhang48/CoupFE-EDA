{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coupfe-eda.local/schemas/validation_manifest.schema.json",
  "title": "CoupFE-EDA TSV validation benchmark manifest",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "benchmark_id", "title", "source", "calibration_role", "data_status", "geometry", "thermal_history", "coordinate_convention", "quantities", "claim_boundary"],
  "properties": {
    "schema_version": {"const": 1},
    "benchmark_id": {"type": "string", "minLength": 1},
    "calibration_role": {"enum": ["calibration", "validation", "model_verification", "external_comparison"]},
    "data_status": {"enum": ["frozen", "definition_only", "blocked"]},
    "source": {
      "type": "object",
      "required": ["citation", "doi", "locator"]
    },
    "quantities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "value", "unit", "uncertainty", "use"]
      }
    },
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
